# PostgreSQL credentials. Use a URL-safe random value (for example, hex).
CLINE_DB_PASSWORD=

# Initial administrator identity. On upgrade, an existing password hash is
# migrated to this email. These values do not reset an existing user.
CLINE_ADMIN_EMAIL=admin@local.test
CLINE_ADMIN_PASSWORD=

# Set true when HTTPS terminates at a trusted reverse proxy.
CLINE_ADMIN_SECURE_COOKIE=false
